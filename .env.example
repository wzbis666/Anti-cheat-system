# ============================================
# AntiCheat System 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# 所有敏感信息必须通过环境变量配置
# ============================================

# 数据库配置
DB_PASSWORD=your_secure_db_password_here

# JWT 密钥 (至少 32 字符，推荐使用 openssl rand -base64 64 生成)
JWT_SECRET=your_jwt_secret_here_at_least_32_characters

# API 密钥 (插件与后端通信用，至少 32 字符)
API_KEY=your_api_key_here_at_least_32_characters

# AI 功能配置 (可选)
AI_ENABLED=false
AI_API_KEY=your_deepseek_api_key_here

# 日志级别 (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
